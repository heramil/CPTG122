#include <iostream>
#include <fstream>
using namespace std;

int main() {
    ifstream inFile("numbers.txt");

    if (!inFile) {
        cout << "Error: Could not open numbers.txt for reading." << endl;
        return 1;
    }

    string line;

    while (getline(inFile, line)) {
        cout << line << endl;
    }

    inFile.close();

    cout << "File read successfully." << endl;

    return 0;
}
