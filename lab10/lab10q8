#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<string> list;
    list.push_back("milk");
    list.push_back("bread");
    list.push_back("eggs");
    list.push_back("rice");
    list.push_back("apple");

    cout << "Shopping list: " << endl;
    for (int i = 0; i < list.size(); i++) {
        cout << "  - " << list[i] << endl;
    }
    cout << endl;
    return 0;
}
